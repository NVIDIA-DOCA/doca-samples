project('DOCA_SAMPLE', 'C',
	license: 'BSD-3',
	default_options: ['buildtype=debug'],
	meson_version: '>= 0.61.2'
)

SAMPLE_NAME = 'telemetry_diag'

# Comment this line to restore warnings of experimental DOCA features
add_project_arguments('-D DOCA_ALLOW_EXPERIMENTAL_API', language: ['c'])

winof2_root = get_option('winof2_root')
json_c_root = get_option('json_c_root')

if json_c_root == ''
	error('JSON-C root path is empty - please set it using: -Djson_c_root=<path>')
endif

doca_sdk_root = winof2_root / 'DOCA_Sdk'

sample_c_args = [
	# ignore zero-sized array in struct/union
	'/wd4200'
]
sample_dependencies = []

# Add json-c library as requirement
sample_dependencies += declare_dependency(
	include_directories: include_directories(join_paths(json_c_root, 'include')),
	link_args: ['-L' + join_paths(json_c_root, 'lib'), '-ljson-c']
)

cc = meson.get_compiler('c')

# Required for all DOCA programs
sample_dependencies += cc.find_library(
	'libdoca_common',
	dirs: [doca_sdk_root / 'lib'],
	required: true,
)

# The DOCA library of the sample itself
sample_dependencies += cc.find_library(
	'libdoca_telemetry',
	dirs: [doca_sdk_root / 'lib'],
	required: true,
)

# Utility DOCA library for executables
sample_dependencies += cc.find_library(
	'libdoca_argp',
	dirs: [doca_sdk_root / 'lib'],
	required: true,
)

sample_srcs = [
	# The sample itself
	SAMPLE_NAME + '_sample.c',
	# Main function for the sample's executable
	SAMPLE_NAME + '_main.c',
]

sample_inc_dirs  = []
sample_inc_dirs += include_directories(join_paths(doca_sdk_root, 'inc'))

executable('doca_' + SAMPLE_NAME, sample_srcs,
	c_args : sample_c_args,
	dependencies : sample_dependencies,
	include_directories: sample_inc_dirs,
	install: false,
)
